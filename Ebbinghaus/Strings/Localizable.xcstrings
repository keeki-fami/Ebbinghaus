    "addProblem.step1.creatingProblem.toggle.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the button above is OFF, only an answer that exactly matches the answer is considered correct. When the button is ON, the answer is considered correct if it contains all of the specified keywords."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上のボタンがOFFの場合は、答えと同じ回答のみ正解にします。上のボタンがONの場合は、解答に、指定したキーワードがすべて含まれていた場合に正解にします。"
          }
        }
      }
    },
